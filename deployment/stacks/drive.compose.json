{
  "services": {
    "ocis": {
      "healthcheck": {
        "test": [
          "CMD",
          "ocis",
          "proxy",
          "health"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 12,
        "start_period": "30s"
      },
      "image": "owncloud/ocis@sha256:8b2249fedba81e8e8ea69ba4baeb880c85978a13a0d73c9bc98ddb3d48dbd4e6",
      "entrypoint": [
        "/bin/sh"
      ],
      "command": [
        "-c",
        "ocis init || true; exec ocis server"
      ],
      "restart": "unless-stopped",
      "environment": {
        "OCIS_URL": "${CI_DRIVE_OCIS_OCIS_URL:?Set CI_DRIVE_OCIS_OCIS_URL}",
        "OCIS_LOG_LEVEL": "${CI_DRIVE_OCIS_OCIS_LOG_LEVEL:?Set CI_DRIVE_OCIS_OCIS_LOG_LEVEL}",
        "OCIS_INSECURE": "${CI_DRIVE_OCIS_OCIS_INSECURE:?Set CI_DRIVE_OCIS_OCIS_INSECURE}",
        "PROXY_TLS": "${CI_DRIVE_OCIS_PROXY_TLS:?Set CI_DRIVE_OCIS_PROXY_TLS}",
        "PROXY_HTTP_ADDR": "${CI_DRIVE_OCIS_PROXY_HTTP_ADDR:?Set CI_DRIVE_OCIS_PROXY_HTTP_ADDR}",
        "GATEWAY_GRPC_ADDR": "${CI_DRIVE_OCIS_GATEWAY_GRPC_ADDR:?Set CI_DRIVE_OCIS_GATEWAY_GRPC_ADDR}",
        "MICRO_REGISTRY_ADDRESS": "${CI_DRIVE_OCIS_MICRO_REGISTRY_ADDRESS:?Set CI_DRIVE_OCIS_MICRO_REGISTRY_ADDRESS}",
        "NATS_NATS_HOST": "${CI_DRIVE_OCIS_NATS_NATS_HOST:?Set CI_DRIVE_OCIS_NATS_NATS_HOST}",
        "NATS_NATS_PORT": "${CI_DRIVE_OCIS_NATS_NATS_PORT:?Set CI_DRIVE_OCIS_NATS_NATS_PORT}",
        "IDM_CREATE_DEMO_USERS": "${CI_DRIVE_OCIS_IDM_CREATE_DEMO_USERS:?Set CI_DRIVE_OCIS_IDM_CREATE_DEMO_USERS}",
        "OCIS_EXCLUDE_RUN_SERVICES": "${CI_DRIVE_OCIS_OCIS_EXCLUDE_RUN_SERVICES:?Set CI_DRIVE_OCIS_OCIS_EXCLUDE_RUN_SERVICES}",
        "OCIS_OIDC_ISSUER": "${CI_DRIVE_OCIS_OCIS_OIDC_ISSUER:?Set CI_DRIVE_OCIS_OCIS_OIDC_ISSUER}",
        "PROXY_OIDC_REWRITE_WELLKNOWN": "${CI_DRIVE_OCIS_PROXY_OIDC_REWRITE_WELLKNOWN:?Set CI_DRIVE_OCIS_PROXY_OIDC_REWRITE_WELLKNOWN}",
        "WEB_OIDC_CLIENT_ID": "${CI_DRIVE_OCIS_WEB_OIDC_CLIENT_ID:?Set CI_DRIVE_OCIS_WEB_OIDC_CLIENT_ID}",
        "WEB_UI_THEME_PATH": "/themes/cloud/theme.json",
        "WEB_UI_CONFIG_FILE": "${CI_DRIVE_OCIS_WEB_UI_CONFIG_FILE:?Set CI_DRIVE_OCIS_WEB_UI_CONFIG_FILE}",
        "WEB_OIDC_SCOPE": "${CI_DRIVE_OCIS_WEB_OIDC_SCOPE:?Set CI_DRIVE_OCIS_WEB_OIDC_SCOPE}",
        "PROXY_AUTOPROVISION_ACCOUNTS": "${CI_DRIVE_OCIS_PROXY_AUTOPROVISION_ACCOUNTS:?Set CI_DRIVE_OCIS_PROXY_AUTOPROVISION_ACCOUNTS}",
        "PROXY_AUTOPROVISION_CLAIM_GROUPS": "${CI_DRIVE_OCIS_PROXY_AUTOPROVISION_CLAIM_GROUPS:?Set CI_DRIVE_OCIS_PROXY_AUTOPROVISION_CLAIM_GROUPS}",
        "PROXY_USER_OIDC_CLAIM": "${CI_DRIVE_OCIS_PROXY_USER_OIDC_CLAIM:?Set CI_DRIVE_OCIS_PROXY_USER_OIDC_CLAIM}",
        "PROXY_USER_CS3_CLAIM": "${CI_DRIVE_OCIS_PROXY_USER_CS3_CLAIM:?Set CI_DRIVE_OCIS_PROXY_USER_CS3_CLAIM}",
        "PROXY_ROLE_ASSIGNMENT_DRIVER": "${CI_DRIVE_OCIS_PROXY_ROLE_ASSIGNMENT_DRIVER:?Set CI_DRIVE_OCIS_PROXY_ROLE_ASSIGNMENT_DRIVER}",
        "GRAPH_ASSIGN_DEFAULT_USER_ROLE": "${CI_DRIVE_OCIS_GRAPH_ASSIGN_DEFAULT_USER_ROLE:?Set CI_DRIVE_OCIS_GRAPH_ASSIGN_DEFAULT_USER_ROLE}",
        "GRAPH_USERNAME_MATCH": "${CI_DRIVE_OCIS_GRAPH_USERNAME_MATCH:?Set CI_DRIVE_OCIS_GRAPH_USERNAME_MATCH}",
        "PROXY_ENABLE_BASIC_AUTH": "${CI_DRIVE_OCIS_PROXY_ENABLE_BASIC_AUTH:?Set CI_DRIVE_OCIS_PROXY_ENABLE_BASIC_AUTH}",
        "PROXY_ENABLE_APP_AUTH": "${CI_DRIVE_OCIS_PROXY_ENABLE_APP_AUTH:?Set CI_DRIVE_OCIS_PROXY_ENABLE_APP_AUTH}",
        "THUMBNAILS_RESOLUTIONS": "${CI_DRIVE_OCIS_THUMBNAILS_RESOLUTIONS:?Set CI_DRIVE_OCIS_THUMBNAILS_RESOLUTIONS}",
        "OCIS_ADD_RUN_SERVICES": "${CI_DRIVE_OCIS_OCIS_ADD_RUN_SERVICES:?Set CI_DRIVE_OCIS_OCIS_ADD_RUN_SERVICES}",
        "PROXY_CSP_CONFIG_FILE_LOCATION": "${CI_DRIVE_OCIS_PROXY_CSP_CONFIG_FILE_LOCATION:?Set CI_DRIVE_OCIS_PROXY_CSP_CONFIG_FILE_LOCATION}",
        "FRONTEND_APP_HANDLER_SECURE_VIEW_APP_ADDR": "${CI_DRIVE_OCIS_FRONTEND_APP_HANDLER_SECURE_VIEW_APP_ADDR:?Set CI_DRIVE_OCIS_FRONTEND_APP_HANDLER_SECURE_VIEW_APP_ADDR}",
        "IDM_ADMIN_PASSWORD": "${CI_DRIVE_OCIS_IDM_ADMIN_PASSWORD:?Set CI_DRIVE_OCIS_IDM_ADMIN_PASSWORD}"
      },
      "volumes": [
        "${RUNTIME_ROOT:?Set RUNTIME_ROOT}/mounts/drive_ocis_0:/etc/ocis",
        "${RUNTIME_ROOT:?Set RUNTIME_ROOT}/mounts/drive_ocis_1:/var/lib/ocis"
      ],
      "ports": [
        "127.0.0.1:${CI_DRIVE_OCIS_HOST_PORT:?Set private port}:9200"
      ],
      "networks": {
        "default": {},
        "workspace": {
          "aliases": [
            "drive-ocis",
            "office-ocis"
          ]
        }
      },
      "mem_limit": "3g"
    },
    "collaboration": {
      "depends_on": {
        "ocis": {
          "condition": "service_healthy"
        }
      },
      "image": "owncloud/ocis@sha256:8b2249fedba81e8e8ea69ba4baeb880c85978a13a0d73c9bc98ddb3d48dbd4e6",
      "command": [
        "collaboration",
        "server"
      ],
      "restart": "unless-stopped",
      "environment": {
        "COLLABORATION_GRPC_ADDR": "${CI_DRIVE_COLLABORATION_COLLABORATION_GRPC_ADDR:?Set CI_DRIVE_COLLABORATION_COLLABORATION_GRPC_ADDR}",
        "COLLABORATION_HTTP_ADDR": "${CI_DRIVE_COLLABORATION_COLLABORATION_HTTP_ADDR:?Set CI_DRIVE_COLLABORATION_COLLABORATION_HTTP_ADDR}",
        "MICRO_REGISTRY": "${CI_DRIVE_COLLABORATION_MICRO_REGISTRY:?Set CI_DRIVE_COLLABORATION_MICRO_REGISTRY}",
        "MICRO_REGISTRY_ADDRESS": "${CI_DRIVE_COLLABORATION_MICRO_REGISTRY_ADDRESS:?Set CI_DRIVE_COLLABORATION_MICRO_REGISTRY_ADDRESS}",
        "COLLABORATION_WOPI_SRC": "${CI_DRIVE_COLLABORATION_COLLABORATION_WOPI_SRC:?Set CI_DRIVE_COLLABORATION_COLLABORATION_WOPI_SRC}",
        "COLLABORATION_APP_NAME": "${CI_DRIVE_COLLABORATION_COLLABORATION_APP_NAME:?Set CI_DRIVE_COLLABORATION_COLLABORATION_APP_NAME}",
        "COLLABORATION_APP_PRODUCT": "${CI_DRIVE_COLLABORATION_COLLABORATION_APP_PRODUCT:?Set CI_DRIVE_COLLABORATION_COLLABORATION_APP_PRODUCT}",
        "COLLABORATION_APP_ADDR": "${CI_DRIVE_COLLABORATION_COLLABORATION_APP_ADDR:?Set CI_DRIVE_COLLABORATION_COLLABORATION_APP_ADDR}",
        "COLLABORATION_APP_ICON": "${CI_DRIVE_COLLABORATION_COLLABORATION_APP_ICON:?Set CI_DRIVE_COLLABORATION_COLLABORATION_APP_ICON}",
        "COLLABORATION_APP_INSECURE": "${CI_DRIVE_COLLABORATION_COLLABORATION_APP_INSECURE:?Set CI_DRIVE_COLLABORATION_COLLABORATION_APP_INSECURE}",
        "COLLABORATION_CS3API_DATAGATEWAY_INSECURE": "${CI_DRIVE_COLLABORATION_COLLABORATION_CS3API_DATAGATEWAY_INSECURE:?Set CI_DRIVE_COLLABORATION_COLLABORATION_CS3API_DATAGATEWAY_INSECURE}",
        "OCIS_URL": "${CI_DRIVE_COLLABORATION_OCIS_URL:?Set CI_DRIVE_COLLABORATION_OCIS_URL}"
      },
      "volumes": [
        "${RUNTIME_ROOT:?Set RUNTIME_ROOT}/mounts/drive_ocis_0:/etc/ocis"
      ],
      "networks": {
        "default": {},
        "workspace": {
          "aliases": [
            "drive-collaboration",
            "office-collaboration"
          ]
        }
      },
      "ports": []
    }
  },
  "networks": {
    "workspace": {
      "external": true,
      "name": "${WORKSPACE_NETWORK:?Create the workspace network}"
    },
    "default": {
      "internal": true
    }
  },
  "volumes": {}
}
