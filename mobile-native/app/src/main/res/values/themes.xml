<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only what shows for the instant before the app draws: the page colour of the day look. -->
    <style name="AppStart" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/start_ground</item>
    </style>
    <color name="start_ground">#F4F7FB</color>
    <!-- The icon's ground: the accent of the day look, the same on every phone and in night mode. -->
    <color name="icon_ground">#0B4F9E</color>
</resources>
