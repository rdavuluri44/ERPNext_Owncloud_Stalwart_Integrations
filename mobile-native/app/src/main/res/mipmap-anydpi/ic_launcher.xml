<?xml version="1.0" encoding="utf-8"?>
<!-- One drawing for every phone's icon shape. The single-colour layer is what Android 13 and newer use for
     "themed icons". The start screen of Android 12 and newer shows this same icon on the page colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/icon_ground" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
