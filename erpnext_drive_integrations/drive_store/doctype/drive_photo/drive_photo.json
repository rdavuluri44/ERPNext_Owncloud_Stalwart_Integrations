{
  "doctype": "DocType",
  "name": "Drive Photo",
  "module": "Drive Store",
  "engine": "InnoDB",
  "field_order": [
    "client_id",
    "project",
    "site",
    "kind",
    "taken_at",
    "taken_by",
    "space_id",
    "path",
    "file_id",
    "latitude",
    "longitude",
    "accuracy_m",
    "from_gallery",
    "captured_offline",
    "tagged",
    "tags",
    "remarks"
  ],
  "fields": [
    {"fieldname": "client_id", "label": "Phone ID", "fieldtype": "Data", "reqd": 1, "unique": 1, "read_only": 1},
    {"fieldname": "project", "label": "Project", "fieldtype": "Link", "options": "Project", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "site", "label": "Site", "fieldtype": "Link", "options": "Field Site", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "kind", "label": "Type", "fieldtype": "Select", "options": "Progress\nHindrance\nIncident\nOther", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "taken_at", "label": "Taken at", "fieldtype": "Datetime", "reqd": 1, "in_list_view": 1},
    {"fieldname": "taken_by", "label": "Taken by", "fieldtype": "Link", "options": "User", "reqd": 1, "in_standard_filter": 1},
    {"fieldname": "space_id", "label": "Drive space", "fieldtype": "Data", "reqd": 1, "read_only": 1},
    {"fieldname": "path", "label": "Drive path", "fieldtype": "Data", "reqd": 1, "read_only": 1},
    {"fieldname": "file_id", "label": "Drive file", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "latitude", "label": "Latitude", "fieldtype": "Float", "precision": "7", "read_only": 1},
    {"fieldname": "longitude", "label": "Longitude", "fieldtype": "Float", "precision": "7", "read_only": 1},
    {"fieldname": "accuracy_m", "label": "GPS accuracy (m)", "fieldtype": "Float", "read_only": 1},
    {"fieldname": "from_gallery", "label": "From gallery", "fieldtype": "Check", "read_only": 1},
    {"fieldname": "captured_offline", "label": "Captured offline", "fieldtype": "Check", "read_only": 1},
    {"fieldname": "tagged", "label": "Tags written in Drive", "fieldtype": "Check", "read_only": 1},
    {"fieldname": "tags", "label": "Tags", "fieldtype": "Small Text", "read_only": 1},
    {"fieldname": "remarks", "label": "Remarks", "fieldtype": "Small Text", "read_only": 1}
  ],
  "track_changes": 1,
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 0,
      "report": 1,
      "export": 1
    }
  ],
  "autoname": "hash",
  "sort_field": "taken_at",
  "sort_order": "DESC"
}
