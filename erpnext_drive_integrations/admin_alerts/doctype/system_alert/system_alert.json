{
  "doctype": "DocType",
  "name": "System Alert",
  "module": "Admin Alerts",
  "engine": "InnoDB",
  "field_order": [
    "alert_key",
    "source",
    "host",
    "severity",
    "status",
    "title",
    "detail",
    "link",
    "first_seen",
    "last_seen",
    "resolved_at",
    "repeat_count"
  ],
  "fields": [
    {"fieldname": "alert_key", "label": "Alert key", "fieldtype": "Data", "reqd": 1, "unique": 1, "read_only": 1},
    {"fieldname": "source", "label": "Source", "fieldtype": "Data", "reqd": 1, "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "host", "label": "Host", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "severity", "label": "Severity", "fieldtype": "Select", "options": "critical\nwarning\ninfo", "reqd": 1, "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Open\nResolved", "default": "Open", "reqd": 1, "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
    {"fieldname": "title", "label": "Title", "fieldtype": "Data", "reqd": 1, "read_only": 1, "in_list_view": 1},
    {"fieldname": "detail", "label": "Detail", "fieldtype": "Small Text", "read_only": 1},
    {"fieldname": "link", "label": "Link", "fieldtype": "Data", "read_only": 1},
    {"fieldname": "first_seen", "label": "First seen", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "last_seen", "label": "Last seen", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "resolved_at", "label": "Resolved at", "fieldtype": "Datetime", "read_only": 1},
    {"fieldname": "repeat_count", "label": "Times reported", "fieldtype": "Int", "read_only": 1}
  ],
  "track_seen": 1,
  "title_field": "title",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 0,
      "create": 0,
      "delete": 1,
      "report": 1
    }
  ],
  "autoname": "hash",
  "sort_field": "last_seen",
  "sort_order": "DESC"
}
